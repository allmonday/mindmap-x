# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
*.egg

# 桌面打包产物（pyinstaller 出 dist/，hdiutil 出 dmg）
*.dmg

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage

# 凭据
.env

# Database / runtime（保留 seed 数据；mindmap.db 等不进库）
var/*
!var/seed_data.json

# Frontend
fe/node_modules/

# Vite 构建产物（npm run build 重建，源码在 fe/）
src/static/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# fe/ 下误跑后端会产生运行时产物（var/ 数据库、上传目录）——根目录的 var/* 不覆盖子目录
fe/var/

# 懒猫微服打包产物（lzc-cli 构建；源配置 lzc-*.yml / images/ 进库）
*.lpk
.lzc-cli-cache/
# lzc-content/ 由 buildscript 每次打包 rm -rf 后从 src/static 拷入——纯构建产物
lzc-content/
